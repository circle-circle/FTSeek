# FTSeek-US 环境变量配置模板 (2026-08-24 全量重生成, 体检 E5)
# 复制为 .env.us 并填入真实值: cp .env.us.example .env.us && vim .env.us
# 代码实读 ~95 个变量, 本模板覆盖 .env.us 现有键 + 代码引用键.
# ⚠️ 所有 *_KEY/*_SECRET/*_TOKEN/*_PWD 为占位符, 必须替换. 勿提交真实值入库.

# ==================== 富途连接与账户 ====================
FUTU_OPEND_HOST=127.0.0.1
FUTU_OPEND_PORT=11111
OPEND_HOST=127.0.0.1
OPEND_PORT=11111
FUTU_LOGIN_ACCOUNT=<YOUR_FUTU_LOGIN_ACCOUNT>
FUTU_LOGIN_PWD=<YOUR_FUTU_LOGIN_PWD>
FUTU_UNLOCK_PWD=<YOUR_FUTU_UNLOCK_PWD>
FUTU_UNLOCK_PWD_MD5=<YOUR_FUTU_UNLOCK_PWD_MD5>
FUTU_TRADE_ENV=1
SIMULATE_ACCOUNT_ID=<YOUR_SIMULATE_ACCOUNT_ID>
REAL_ACCOUNT_ID=<YOUR_REAL_ACCOUNT_ID>
ENABLE_FUTU_LV3=true

# ==================== 交易模式与安全 ====================
AUTO_TRADE_ACCOUNT=sim
TRADE_ENV=1
ALLOW_REAL_TRADING=false
FTSEEK_ALLOW_RUNTIME_TRADE_ENV_SWITCH=
LIVE_CONSERVATIVE=1
RFC061_LIVE_OVERNIGHT_ENABLED=
WATCHDOG_AUTO_HEAL=

# ==================== LLM / 模型配置 ====================
BAILIAN_API_KEY=<YOUR_BAILIAN_API_KEY>
BAILIAN_BASE_URL=
BAILIAN_MODEL=qwen-max
BAILIAN_MODEL_MAIN=qwen-max
BAILIAN_MODEL_EXEC=qwen-max
BAILIAN_MODEL_RISK=glm-5
BAILIAN_MODEL_STRATEGY=qwen-max
BAILIAN_MODEL_OBS=qwen-max
BAILIAN_MODEL_KIMI=kimi-k2.5
BAILIAN_MODEL_MINIMAX=MiniMax-M2.5
BAILIAN_TIMEOUT=30
DEEPSEEK_API_KEY=<YOUR_DEEPSEEK_API_KEY>
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DASHSCOPE_API_KEY=<YOUR_DASHSCOPE_API_KEY>
