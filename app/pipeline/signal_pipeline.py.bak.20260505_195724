"""
信号管线 — FTSeek-US 核心决策链路

从 scheduler_tasks.py 拆分而来。本模块包含完整的信号生成到决策管线，
回测适配层和实盘调度器共用此代码。

管线流程:
    scan_loop()                  # 主循环: 市场门禁 + 熔断 + 巡检
      └─ _run_signal_scan_impl() # 自适应轮询批次
           └─ _process_symbol_impl()  # 单标的完整决策链路
                ├─ 行情获取 + 动态成本注入
                ├─ 财报感知 + VIX Regime 注入
                ├─ 作战计划快车道 (跳过投票)
                ├─ 信号生成 (盘中技术面 / 盘后LLM投票)
                ├─ 大盘联动过滤 + 金字塔加仓检测
                ├─ 共识检查 + SignalScore 构建
                └─ 风控检查 → 下单委托
"""
from __future__ import annotations

