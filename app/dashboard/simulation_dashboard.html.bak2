<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FTSeek 模拟盘监控看板</title>
    <script src="https://cdn.jsdelivr.net/npm/echarts@5.4.3/dist/echarts.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        :root {
            --bg-primary: #0a0e1a;
            --bg-secondary: #111827;
            --bg-card: #1a1f2e;
            --border-color: #2d3748;
            --text-primary: #f7fafc;
            --text-secondary: #a0aec0;
            --accent-blue: #3b82f6;
            --accent-green: #10b981;
            --accent-red: #ef4444;
            --accent-yellow: #f59e0b;
        }
        body { font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, sans-serif; background: var(--bg-primary); color: var(--text-primary); min-height: 100vh; }
        .container { max-width: 1400px; margin: 0 auto; padding: 20px; }
        header { background: var(--bg-secondary); border-bottom: 1px solid var(--border-color); padding: 20px 30px; display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; z-index: 100; }
        .header-title { font-size: 24px; font-weight: 600; }
        .header-subtitle { font-size: 14px; color: var(--text-secondary); margin-top: 4px; }
        .status-badge { display: inline-flex; align-items: center; padding: 6px 12px; background: rgba(16, 185, 129, 0.1); border: 1px solid var(--accent-green); border-radius: 6px; font-size: 12px; color: var(--accent-green); }
        .status-dot { width: 8px; height: 8px; background: var(--accent-green); border-radius: 50%; margin-right: 6px; animation: pulse 2s infinite; }
        @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
        
        .kpi-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin: 30px 0; }
        .kpi-card { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 24px; }
        .kpi-label { font-size: 13px; color: var(--text-secondary); margin-bottom: 8px; }
        .kpi-value { font-size: 32px; font-weight: 700; margin-bottom: 8px; }
        .kpi-value.positive { color: var(--accent-green); }
        .kpi-value.negative { color: var(--accent-red); }
        .kpi-sub { font-size: 12px; color: var(--text-secondary); }
        
        .section { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 24px; margin: 30px 0; }
        .section-title { font-size: 18px; font-weight: 600; margin-bottom: 20px; display: flex; align-items: center; }
        .section-icon { margin-right: 10px; }
        
        .data-table { width: 100%; border-collapse: collapse; }
        .data-table th { text-align: left; padding: 12px; background: var(--bg-secondary); color: var(--text-secondary); font-size: 13px; border-bottom: 1px solid var(--border-color); }
        .data-table td { padding: 12px; border-bottom: 1px solid var(--border-color); font-size: 14px; }
        .data-table tr:hover { background: var(--bg-secondary); }
        .badge { display: inline-block; padding: 4px 8px; border-radius: 4px; font-size: 12px; font-weight: 500; }
        .badge-open { background: rgba(59, 130, 246, 0.1); color: var(--accent-blue); }
        .badge-closed { background: rgba(16, 185, 129, 0.1); color: var(--accent-green); }
        
        .chart-container { height: 300px; position: relative; }
        .no-data { text-align: center; padding: 60px 20px; color: var(--text-secondary); }
        .info-box { background: rgba(59, 130, 246, 0.1); border: 1px solid var(--accent-blue); border-radius: 8px; padding: 16px; margin: 20px 0; }
        .info-title { font-weight: 600; color: var(--accent-blue); margin-bottom: 8px; }
        .info-text { font-size: 14px; color: var(--text-secondary); }
    </style>
</head>
<body>
    <header>
        <div>
            <div class="header-title">📊 FTSeek 模拟盘监控看板</div>
            <div class="header-subtitle">数据日期：<span id="currentDate">-</span> (仅今日数据)</div>
        </div>
        <div class="status-badge"><span class="status-dot"></span>实时同步中</div>
    </header>
    
    <div class="container">
        <div class="info-box">
            <div class="info-title">💡 数据说明</div>
            <div class="info-text">从 2026-03-31 开始积累交易数据，仅显示今日成交记录。资产净值、盈亏数据将在交易平仓后自动计算。</div>
        </div>
        
        <div class="kpi-grid" id="kpiGrid">
            <div class="kpi-card">
                <div class="kpi-label">初始资金</div>
                <div class="kpi-value">1,000,000</div>
                <div class="kpi-sub">HKD</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">今日交易数</div>
                <div class="kpi-value" id="todayTrades">-</div>
                <div class="kpi-sub" id="tradesDetail">等待数据加载</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">今日盈亏</div>
                <div class="kpi-value" id="todayPnl">-</div>
                <div class="kpi-sub">待平仓后计算</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">胜率</div>
                <div class="kpi-value" id="winRate">-</div>
                <div class="kpi-sub">待平仓后统计</div>
            </div>
        </div>
        
        <div class="section">
            <div class="section-title"><span class="section-icon">📈</span>今日持仓</div>
            <div id="positionsTable">
                <div class="no-data">正在加载持仓数据...</div>
            </div>
        </div>
        
        <div class="section">
            <div class="section-title"><span class="section-icon">📋</span>今日交易记录</div>
            <div id="tradesTable">
                <div class="no-data">正在加载交易数据...</div>
            </div>
        </div>
    </div>
    
    <script>
        const API_BASE = '/api/v1/review';
        const TODAY = new Date().toISOString().split('T')[0];
        
        document.getElementById('currentDate').textContent = TODAY;
        
        async function loadData() {
            try {
                const response = await fetch(`${API_BASE}/trades?limit=100`);
                const result = await response.json();
                
                if (result.status === 'ok' && result.data) {
                    const trades = result.data.filter(t => t.entry_time && t.entry_time.startsWith(TODAY));
                    
                    document.getElementById('todayTrades').textContent = trades.length;
                    document.getElementById('tradesDetail').textContent = `${trades.filter(t => t.status === 'closed').length} 已平仓 / ${trades.filter(t => t.status === 'open').length} 持仓中`;
                    
                    const closedTrades = trades.filter(t => t.status === 'closed');
                    const totalPnl = closedTrades.reduce((sum, t) => sum + (t.pnl || 0), 0);
                    const winTrades = closedTrades.filter(t => t.pnl > 0);
                    const winRate = closedTrades.length > 0 ? (winTrades.length / closedTrades.length * 100) : 0;
                    
                    document.getElementById('todayPnl').textContent = (totalPnl >= 0 ? '+' : '') + totalPnl.toFixed(2) + ' HKD';
                    document.getElementById('todayPnl').className = 'kpi-value ' + (totalPnl >= 0 ? 'positive' : 'negative');
                    document.getElementById('winRate').textContent = winRate.toFixed(1) + '%';
                    
                    renderPositions(trades);
                    renderTrades(trades);
                }
            } catch (error) {
                console.error('加载数据失败:', error);
                document.getElementById('tradesDetail').textContent = '数据加载失败';
            }
        }
        
        function renderPositions(trades) {
            const positionsDiv = document.getElementById('positionsTable');
            const openTrades = trades.filter(t => t.status === 'open');
            
            if (openTrades.length === 0) {
                positionsDiv.innerHTML = '<div class="no-data">暂无持仓</div>';
                return;
            }
            
            let html = '<table class="data-table"><thead><tr><th>订单 ID</th><th>代码</th><th>名称</th><th>方向</th><th>成交价</th><th>数量</th><th>时间</th><th>状态</th></tr></thead><tbody>';
            openTrades.forEach(t => {
                html += `<tr>
                    <td>${t.id || '-'}</td>
                    <td>${t.code || '-'}</td>
                    <td>${t.name || '-'}</td>
                    <td><span class="badge ${t.action === 'BUY' ? 'badge-open' : 'badge-closed'}">${t.action}</span></td>
                    <td>${(t.exit_price || t.entry_price || 0).toFixed(1)}</td>
                    <td>${t.quantity || 0}</td>
                    <td>${(t.entry_time || '').replace('T', ' ').substr(0, 16)}</td>
                    <td><span class="badge badge-open">持仓中</span></td>
                </tr>`;
            });
            html += '</tbody></table>';
            positionsDiv.innerHTML = html;
        }
        
        function renderTrades(trades) {
            const tradesDiv = document.getElementById('tradesTable');
            
            if (trades.length === 0) {
                tradesDiv.innerHTML = '<div class="no-data">暂无交易记录</div>';
                return;
            }
            
            let html = '<table class="data-table"><thead><tr><th>订单 ID</th><th>代码</th><th>名称</th><th>方向</th><th>成交价</th><th>数量</th><th>盈亏</th><th>时间</th><th>状态</th></tr></thead><tbody>';
            trades.slice(0, 50).forEach(t => {
                const pnlClass = (t.pnl || 0) >= 0 ? 'positive' : 'negative';
                const pnlText = t.status === 'closed' ? ((t.pnl >= 0 ? '+' : '') + t.pnl.toFixed(2) + ' HKD') : '-';
                html += `<tr>
                    <td>${t.id || '-'}</td>
                    <td>${t.code || '-'}</td>
                    <td>${t.name || '-'}</td>
                    <td><span class="badge ${t.action === 'BUY' ? 'badge-open' : 'badge-closed'}">${t.action}</span></td>
                    <td>${(t.exit_price || t.entry_price || 0).toFixed(1)}</td>
                    <td>${t.quantity || 0}</td>
                    <td class="${pnlClass}">${pnlText}</td>
                    <td>${(t.entry_time || '').replace('T', ' ').substr(0, 16)}</td>
                    <td><span class="badge ${t.status === 'closed' ? 'badge-closed' : 'badge-open'}">${t.status === 'closed' ? '已平仓' : '持仓中'}</span></td>
                </tr>`;
            });
            html += '</tbody></table>';
            tradesDiv.innerHTML = html;
        }
        
        loadData();
        setInterval(loadData, 60000);
    </script>
</body>
</html>
