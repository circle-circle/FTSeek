# .env.example - FTSeek AI 配置示例

# ═══════════════════════════════════════
# AI 大模型集成配置
# ═══════════════════════════════════════

# AI 功能开关 (默认关闭)
FTSEEK_ENABLE_AI=false

# AI Provider 选择 (bailian/qwen/glm)
AI_PROVIDER=bailian

# Bailian (百炼) API Key
# 获取方式：阿里云控制台 → 百炼平台 → API Key 管理
BAILIAN_API_KEY=your_api_key_here
BAILIAN_ENDPOINT=dashscope.aliyuncs.com
BAILIAN_MODEL=qwen-plus
BAILIAN_TIMEOUT=30

# Qwen (通义千问) API Key (可选)
# QWEN_API_KEY=your_api_key_here

# GLM (智谱) API Key (可选)
# GLM_API_KEY=your_api_key_here

# ═══════════════════════════════════════
# AI 融合策略配置
# ═══════════════════════════════════════

# AI 权重 (0.0-1.0)
# 权重越高，AI 预测对最终信号影响越大
FTSEEK_AI_WEIGHT=0.3

# ═══════════════════════════════════════
# 成本与预算控制
# ═══════════════════════════════════════

# 每日预算上限 (元)
AI_DAILY_BUDGET=100

# 每月预算上限 (元)
AI_MONTHLY_BUDGET=3000

# API 调用限流 (次/分钟)
AI_REQUESTS_PER_MINUTE=10

# ═══════════════════════════════════════
# 缓存配置
# ═══════════════════════════════════════

# 缓存生存时间 (秒)
# 减少重复 API 调用，降低成本
AI_CACHE_TTL=3600

# 最大缓存条目数
AI_CACHE_MAX_SIZE=1000

# ═══════════════════════════════════════
# 日志配置
# ═══════════════════════════════════════

# AI 模块日志级别 (DEBUG/INFO/WARNING/ERROR)
AI_LOG_LEVEL=INFO

# ═══════════════════════════════════════
# 使用说明
# ═══════════════════════════════════════

# 1. 复制此文件为 .env
#    cp .env.example .env

# 2. 填写你的 API Key
#    vim .env

# 3. 启用 AI 功能 (可选)
#    FTSEEK_ENABLE_AI=true

# 4. 重启服务
#    ./start.sh

# ═══════════════════════════════════════
# 成本估算参考
# ═══════════════════════════════════════

# Qwen-plus 定价：¥0.01/1K tokens
# 假设每次调用 500 tokens，每日 1000 次调用
# 日成本：1000 * 500 * 0.01 / 1000 = ¥5
# 月成本：¥5 * 30 = ¥150

# 使用缓存后可减少 50%+ 调用
# 实际月成本：¥75 左右
