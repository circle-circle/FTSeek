venv/
*.pyc
__pycache__/
*.bak
logs/
data/*.db
*.log

# 密钥文件 — 绝对不可提交
.env
.env.*
*.env
.env.backup.*
.backups/

# 2026-07-26 迁移备份区 (含 env 明文副本+旧历史镜像) — 永不入库
.backup_premigration/
tmp_e2e_out.txt

# 2026-07-26 历史重写时剥离的 129MB 二进制 (曾撞 GitHub 100MB 限制) — 永不入库
node_modules/

# 数据库备份 — 不应入库
data/backups/

# 数据库文件(所有路径, 覆盖 app/data/ 与根目录)+ SQLite WAL/SHM — 不应入库
*.db
*.db-wal
*.db-shm
# 各类备份/损坏文件 (*.bak 只匹配后缀, *.bak* 才能抓到 .bak.时间戳 / .bak_xxx)
*.bak*
*.corrupted*

*__pycache__*
*.pyc

# 工具运行时目录 (Qoder/Hermes plans/worktrees/settings) — 不应入库
.qoder/
.hermes/

# 2026-08-16 做减法: data/ 是运行时输出目录 (缓存/遥测/审计jsonl/每日快照), 整体忽略
# 白名单仅保留审计种子 (配置冻结快照)。新增需入库的 data 种子须在此加 ! 显式放行。
data/*
!data/config_freeze_v2.json
