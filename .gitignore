venv/
*.pyc
__pycache__/
*.bak
logs/
data/*.db
*.log

# 密钥文件 — 绝对不可提交
.env
.env.*
*.env
.env.backup.*
# 2026-08-24 (C5 体检 E5): .env.us.example 是脱敏模板, 必须入库供新环境复制;
# 上面 .env.* 规则会误伤它, 加显式例外 (真实密钥仍在 .env.us, 不受影响).
!.env.us.example
.backups/

# 2026-07-26 迁移备份区 (含 env 明文副本+旧历史镜像) — 永不入库
.backup_premigration/
tmp_e2e_out.txt

# 2026-07-26 历史重写时剥离的 129MB 二进制 (曾撞 GitHub 100MB 限制) — 永不入库
node_modules/

# 数据库备份 — 不应入库
data/backups/

# 数据库文件(所有路径, 覆盖 app/data/ 与根目录)+ SQLite WAL/SHM — 不应入库
*.db
*.db-wal
*.db-shm
# 各类备份/损坏文件 (*.bak 只匹配后缀, *.bak* 才能抓到 .bak.时间戳 / .bak_xxx)
*.bak*
*.corrupted*

*__pycache__*
*.pyc

# 工具运行时目录 (Qoder/Hermes plans/worktrees/settings) — 不应入库
.qoder/
.hermes/

# 2026-08-16 做减法: data/ 是运行时输出目录 (缓存/遥测/审计jsonl/每日快照), 整体忽略
# 白名单仅保留审计种子 (配置冻结快照)。新增需入库的 data 种子须在此加 ! 显式放行。
data/*
!data/config_freeze_v2.json
# 2026-10-03 (复查批): W456 日志卫生棘轮的基线同为判据种子 (与 preflight_baseline 同性质) —
#   此前不入库 + 测试约定「基线缺失即重建同零违反」= 删掉基线文件即可洗白违规 (结构性漏洞)。
#   入库后: 基线变更 = 可评审 diff; 本地删除 = git status 可见。回滚 = 删以下三行。
!data/debug_swallow_baseline.json
!data/bare_logger_baseline.json
!data/except_stack_baseline.json

# 2026-09-14 (DEB-20260914-cutover-bidirectional-seamless): 切换预检的**棘轮基线**是判据种子
# (与 config_freeze_v2 同性质 — 记录"何时把什么冻结为已知常态"), 须入库以便评审。
# 同目录 preflight_*.json 逐次快照仍出库 (cron 每日重生成, 入库会把树搞脏)。
# 丢了基线不会静默: --watch fail-loud(exit 2) 并要求人工 --accept-baseline。
# 回滚 = 删以下三行
!data/cutover/
data/cutover/*
!data/cutover/preflight_baseline.json

# 2026-08-22 (DEB-20260822): cron 自动重生成的产物出库 — 树常年脏淹没真变更; 回滚=删以下两行+git add
config/exit_calibration.json
data/exit_rule_expectancy_latest.json
