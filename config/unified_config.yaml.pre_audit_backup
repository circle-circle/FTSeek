  phases:
    base_params:
      tp_pct: 0.012
      sl_pct: 0.007
      position_pct: 0.08
      max_hold_minutes: 4
    opening_drive:
      enabled: true
      start_minutes: 575
      end_minutes: 600
      directions:
      - LONG
      - SHORT
      signals:
      - momentum
      - breakout
      tp_scale: 1.5
      sl_scale: 1.5
      pos_scale: 0.5
      hold_scale: 1.5
      extra_filter: 顺SPY开盘方向，逆SPY方向不做
    morning:
      enabled: true
      start_minutes: 600
      end_minutes: 690
      directions:
      - LONG
      - SHORT
      signals:
      - rsi
      - vwap
      - momentum
      tp_scale: 1.2
      sl_scale: 1.2
      pos_scale: 1.0
      hold_scale: 1.2
    midday:
      enabled: true
      start_minutes: 690
      end_minutes: 840
      directions:
      - LONG
      - SHORT
      signals:
      - rsi
      - bollinger
      tp_scale: 0.7
      sl_scale: 0.7
      pos_scale: 0.9
      hold_scale: 1.0
      extra_filter: SPY偏离VWAP>0.3%时只做顺趋势方向
    afternoon:
      enabled: true
      start_minutes: 840
      end_minutes: 930
      directions:
      - LONG
      signals:
      - rsi
      - vwap
      - momentum
      tp_scale: 1.0
      sl_scale: 1.0
      pos_scale: 0.9
      hold_scale: 1.0
    closing_drive:
      enabled: true
      start_minutes: 930
      end_minutes: 960
      directions:
      - LONG
      signals:
      - rsi
      tp_scale: 0.5
      sl_scale: 0.7
      pos_scale: 0.3
      hold_scale: 0.5
      force_close_at: 955
      no_new_entry_after: 950
    transition_smoothing_minutes: 2
  trend_filter:
    spy_threshold: 0.03
    vix_threshold: 35
  circuit_breaker:
    max_consecutive_losses: 3
    cooldown_minutes: 60
  polling_interval_seconds: 5
  pool:
    min_volume: 5000000
    min_price: 10
    max_price: 500
    min_atr_pct: 0.008
    max_atr_pct: 0.04
  stock_selection:
    min_daily_volume: 1000000
    min_amplitude: 0.02
    exclude_earnings_blackout: true
    max_targets: 15
    exclude_earnings_today: true
