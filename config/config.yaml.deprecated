# ============================================================================
# FTSeek 统一配置文件 v2.0
# ============================================================================
# 说明：
#   本配置文件整合了所有分散的配置项，包括：
#   - risk_config.yaml (风控配置)
#   - strategy_params.json (策略参数)
#   - dynamic_exit_params.yaml (动态止盈止损)
#   - position_strategy.yaml (仓位策略)
#   - alert_rules.yaml (告警规则)
#
# 更新时间：2026-04-05
# 版本：v2.0 (配置中心优化版)
# ============================================================================

version: "2.0.0"
updated: "2026-04-05"
description: "FTSeek 量化交易系统 - 统一配置"

# ============================================================================
# 1. 基础配置
# ============================================================================
base:
  environment: production           # development | staging | production
  log_level: INFO
  debug_mode: false

# ============================================================================
# 2. 富途 OpenD 配置
# ============================================================================
futu:
  host: "127.0.0.1"
  port: 11111
  opend_dir: "/opt/ftseek/Futu_OpenD_10.3.6308_Centos7/Futu_OpenD_10.3.6308_Centos7"

  # 登录配置
  login_account: "${FUTU_LOGIN_ACCOUNT}"
  login_password: "${FUTU_LOGIN_PWD}"

  # 交易环境
  trade_env: 1                      # 0=实盘，1=模拟盘
  force_simulate: true              # 强制模拟模式
  simulate_account_id: "18820895"   # 模拟账户 ID (CASH 账户)
  margin_account_id: "8246818"      # 融资账户 ID (支持期权/卖空)
  us_account_id: 0                  # 美股账户 ID (2026-04-26 P0-5 新增，未启用时填 0)

  # 安全配置
  allow_real_trading: false         # 是否允许实盘交易

# ============================================================================
# 2.1 OpenClaw / 外部能力包路径 (2026-04-26 P0-7 新增)
#  优先级：env FTSEEK_OPENCLAW_SKILLS_DIR > 本配置 > 历史硬编码 fallback
# ============================================================================
openclaw:
  skills_dir: "/root/.openclaw/skills/openapi/scripts"   # account_selection.py 等外部脚本目录

# ============================================================================
# 2.2 Strategy 核心脚本路径 (2026-04-26 P0-7 新增)
#  优先级：env FTSEEK_WEIGHT_ENGINE_PATH > 本配置 > 相对路径 fallback
# ============================================================================
# strategy.weight_engine_path 已统一放入 strategy 节点下（见下方）


# ============================================================================
# 3. 交易配置
# ============================================================================
trading:
  mode: paper                       # paper (模拟) | real (实盘)
  currency: HKD

  # 监控股票池 (2026-04-12 扩展至 30 只，覆盖 8 大行业板块)
  #
  # 扩容策略:
  #  模拟交易阶段增加覆盖面，充分验证信号生成、新闻关联、联动检测能力
  #  覆盖: 互联网(6) + 半导体(3) + 新能源(4) + 金融(4) + 医药(3)
  #        + 消费(4) + 能源(3) + AI/游戏(3) = 30 只
  watch_list_hk:
    # ========================================
    # 港股监控名单 (2026-04-20 严格筛选: 日均成交额 ≥ 1亿港元)
    # 仅保留行业龙头 + 高流动性标的, 共 20 只
    # 覆盖: 互联网(6) + 半导体(1) + 新能源车(4) + 金融(3) + 医药(1) + 消费(2) + 能源(1) + 通信(1) + 其他(1)
    # ========================================

    # --- 互联网/电商/科技 (6只) ---
    - "HK.00700"  # 腾讯控股 (社交+游戏+云, 日均20亿)
    - "HK.09988"  # 阿里巴巴 (电商+云, 日均15亿)
    - "HK.03690"  # 美团-W (本地生活, 日均12亿)
    - "HK.09618"  # 京东集团 (电商+物流, 日均8亿)
    - "HK.01024"  # 快手-W (短视频, 日均5亿)
    - "HK.09888"  # 百度集团 (搜索+AI, 日均3亿)

    # --- 半导体 (2只) ---
    - "HK.00981"  # 中芯国际 (晶圆代工, 日均2亿)
    - "HK.01347"  # 华虹半导体 (晶圆代工, 日均1.5亿)

    # --- 新能源车/汽车 (4只) ---
    - "HK.01810"  # 小米集团-W (消费电子+汽车, 日均6亿)
    - "HK.01211"  # 比亚迪股份 (新能源车全球龙头, 日均10亿)
    - "HK.02015"  # 理想汽车-W (增程SUV龙头, 日均4亿)
    - "HK.09868"  # 小鹏汽车-W (智能驾驶, 日均4亿)

    # --- 金融/保险 (3只) ---
    - "HK.02318"  # 中国平安 (保险龙头, 日均7亿)
    - "HK.00388"  # 香港交易所 (交易所垄断, 日均5亿)
    - "HK.01299"  # 友邦保险 (亚洲保险, 日均1.5亿)

    # --- 医药 (1只) ---
    - "HK.02269"  # 药明生物 (CXO龙头, 日均1.5亿)

    # --- 消费 (2只) ---
    - "HK.09992"  # 泡泡玛特 (潮玩龙头, 日均2亿)
    - "HK.02020"  # 安踏体育 (运动品牌, 日均2亿)

    # --- 能源 (1只) ---
    - "HK.00883"  # 中国海洋石油 (海上油气龙头, 日均3亿)

    # --- 通信 (1只) ---
    - "HK.00941"  # 中国移动 (运营商龙头, 日均2亿)

    # --- 游戏/娱乐 (1只) ---
    - "HK.09999"  # 网易-S (游戏龙头, 日均3亿)

  # ========================================

  # ========================================
  # 美股监控名单 (全行业龙头覆盖 - 模拟期扩容)
  # 覆盖: ETF(5) + 中概股(10) + 科技/AI(9) + 半导体(6)
  #       + 新能源车(4) + 金融(5) + 医疗/制药(5) + 消费/零售(5)
  #       + 能源(4) + 工业/防务(4) = 57 只
  # ========================================
  watch_list_us:
    # ========================================
    # 美股监控名单 (2026-04-20 严格筛选: 日均成交额 ≥ $1亿)
    # 仅保留行业龙头 + 高流动性标的, 共 20 只
    # 覆盖: 基准ETF(2) + 中概股(5) + 科技/AI(6) + 半导体(3) + 新能源车(1) + 金融(1) + 医疗(1) + 消费(1)
    # ========================================

    # --- 大盘基准 ETF (2只) ---
    - "US.SPY"    # S&P 500 (大盘基准, 日均50亿)
    - "US.QQQ"    # 纳斯达克100 (科技基准, 日均30亿)

    # --- 中概股/ADR (5只) ---
    - "US.BABA"   # 阿里巴巴 → HK.09988 (日均12亿)
    - "US.JD"     # 京东 → HK.09618 (日均4亿)
    - "US.PDD"    # 拼多多 (日均4亿)
    - "US.NTES"   # 网易 → HK.09999 (日均1亿)
    - "US.BIDU"   # 百度 → HK.09888 (日均1亿)

    # --- 科技/AI (6只) ---
    - "US.AAPL"   # 苹果 (消费电子龙头, 日均35亿)
    - "US.MSFT"   # 微软 (企业云+AI龙头, 日均30亿)
    - "US.NVDA"   # 英伟达 (AI芯片龙头, 日均25亿)
    - "US.AMZN"   # 亚马逊 (电商+云龙头, 日均20亿)
    - "US.META"   # Meta (社交+AI龙头, 日均18亿)
    - "US.TSLA"   # 特斯拉 (电动车龙头, 日均15亿)

    # --- 半导体 (3只) ---
    - "US.AMD"    # AMD (CPU/GPU, 日均5亿)
    - "US.AVGO"   # Broadcom (网络芯片, 日均4亿)
    - "US.TSM"    # 台积电 (晶圆代工, 日均1亿)

    # --- 新能源车 (1只) ---
    - "US.NIO"    # 蔚来 → HK.09866 (日均2.5亿)

    # --- 金融 (1只) ---
    - "US.JPM"    # 摩根大通 (投行龙头, 日均8亿)

    # --- 医疗 (1只) ---
    - "US.LLY"    # 礼来 (减肥药龙头, 日均6亿)

    # --- 消费 (1只) ---
    - "US.WMT"    # 沃尔玛 (零售龙头, 日均1亿)

  # 仓位限制 (2026-04-13 优化：适应 30 股监控池)
  # (仓位限制已统一在 risk_limits 中管理)
  # (总仓位限制已统一在 risk_limits 中管理)
  max_open_positions: 20            # 最大持仓数 20 (2026-04-18: 12->20, 兼容当前 15 只历史遗留持仓)
  default_position_size: 0.10       # 默认仓位大小 10%

  # 交易频率
  # (交易频率已统一在 risk_limits 中管理)
  # (日亏损已统一在 risk_limits 中管理)
  # (周亏损已统一在 risk_limits 中管理)

  # 信号要求 (2026-04-24 统一: min_confidence 唯一数据源为 risk_limits.min_confidence=0.35)
  # min_signal_confidence 已废弃，请使用 risk_limits.min_confidence
  manual_confirm_for_live: true     # 实盘需手动确认

  # 做空配置
  short_selling_enabled: false      # 是否允许做空（默认关闭）
  
  # 做空门禁配置 (2026-04-24 新增)
  # 原则：宁可错过，不可做错。做空风险远高于做多，必须设置更高的证据门槛。
  # 全自动系统：极高证据自动执行，高证据钉钉 FYI + 自动执行，不足则降级观察。
  short_gate:
    enabled: false                  # 做空中门开关（需 short_selling_enabled=true 才生效）
    min_confidence: 0.70            # 做空最低置信度（做多 0.35 的 2 倍）
    min_relevance: 0.75             # 事件相关性要求（做多 0.55 的 1.36 倍）
    min_logic_chain_steps: 3        # 最少逻辑链步骤数
    require_second_order: true      # 必须有二阶推理
    require_risk_path: true         # 必须说明风险路径
    require_invalidating_factors: true  # 必须列出否定因素
    require_market_downtrend: true  # 大盘必须处于下跌趋势
    # ── 自动执行门槛 (极高) ──
    auto_execute_confidence: 0.85   # 极高证据：conf >= 0.85 → 直接自动执行
    auto_execute_relevance: 0.85    # 极高证据：relevance >= 0.85 → 直接自动执行
    # 介于 min 和 auto 之间的信号 → review (钉钉高优 FYI + 自动执行)
    cooldown_seconds: 600           # 5 分钟冷却（做多的 5 倍）
    max_position_ratio: 0.05        # 做空最大仓位 5%（做多 8% 的 62.5%）

  # 订单配置 (2026-04-06 从 app/config.py 迁移)
  order:
    # 默认下单数量 (按股票配置)
    default_order_qty_by_code:
      # 互联网/电商
      'HK.00700': 100    # 腾讯 1 手
      'HK.09988': 100    # 阿里 1 手
      'HK.03690': 100    # 美团 1 手
      'HK.09618': 100    # 京东 1 手
      'HK.01024': 100    # 快手 1 手
      'HK.09888': 100    # 百度 1 手
      # 半导体/芯片
      'HK.00981': 500    # 中芯国际 1 手
      'HK.01347': 1000   # 华虹半导体 1 手
      'HK.02382': 200    # 舜宇光学 1 手
      # 新能源车/汽车
      'HK.01810': 200    # 小米 1 手
      'HK.01211': 500    # 比亚迪 1 手
      'HK.02015': 100    # 理想 1 手
      'HK.09868': 100    # 小鹏 1 手
      # 金融/保险
      'HK.02318': 500    # 平安 1 手
      'HK.01299': 200    # 友邦 1 手
      'HK.00388': 100    # 港交所 1 手
      'HK.00941': 500    # 中国移动 1 手
      # 医药/生物
      'HK.02269': 500    # 药明生物 1 手
      'HK.01801': 1000   # 信达生物 1 手
      'HK.06618': 100    # 京东健康 1 手
      # 消费/零售
      'HK.09992': 200    # 泡泡玛特 1 手
      'HK.02020': 100    # 安踏 1 手
      'HK.01928': 400    # 金沙中国 1 手
      'HK.09926': 500    # 康方生物 1 手
      # 能源/资源
      'HK.00883': 1000   # 中海油 1 手
      'HK.00857': 2000   # 中石油 1 手
      'HK.02899': 2000   # 紫金矿业 1 手
      # AI/游戏/旅游
      'HK.00772': 1000   # 阅文 1 手
      'HK.09961': 100    # 携程 1 手
      'HK.09999': 100   # 网易 1 手

    # 每手股数配置
    hk_lot_sizes:
      # 互联网/电商
      'HK.00700': 100   # 腾讯
      'HK.09988': 100   # 阿里
      'HK.03690': 100   # 美团
      'HK.09618': 100   # 京东
      'HK.01024': 100   # 快手
      'HK.09888': 100   # 百度
      # 半导体/芯片
      'HK.00981': 500   # 中芯国际
      'HK.01347': 1000  # 华虹半导体
      'HK.02382': 200   # 舜宇光学
      # 新能源车/汽车
      'HK.01810': 200   # 小米
      'HK.01211': 500   # 比亚迪
      'HK.02015': 100   # 理想
      'HK.09868': 100   # 小鹏
      # 金融/保险
      'HK.02318': 500   # 平安
      'HK.01299': 200   # 友邦
      'HK.00388': 100   # 港交所
      'HK.00941': 500   # 中国移动
      # 医药/生物
      'HK.02269': 500   # 药明生物
      'HK.01801': 1000  # 信达生物
      'HK.06618': 100   # 京东健康
      # 消费/零售
      'HK.09992': 200   # 泡泡玛特
      'HK.02020': 100   # 安踏
      'HK.01928': 400   # 金沙中国
      'HK.09926': 500   # 康方生物
      # 能源/资源
      'HK.00883': 1000  # 中海油
      'HK.00857': 2000  # 中石油
      'HK.02899': 2000  # 紫金矿业
      # AI/游戏/旅游
      'HK.00772': 1000  # 阅文
      'HK.09961': 100   # 携程
      'HK.09999': 100    # 网易 1 手

    # 默认订单数量
    default_order_qty_hk: 100       # 港股默认 100 股 (需整手，具体每手股数见 hk_lot_sizes)
    default_order_qty_us: 1         # 美股默认 1 股 (美股最小交易单位 1 股，无碎股问题)
    default_order_qty: 100          # 兼容旧逻辑

    # 订单类型
    default_order_type: "MARKET"    # MARKET (市价) | LIMIT (限价)
    max_order_amount: 120000.0      # 最大单笔金额 (港币)

  # 执行质量配置 (2026-04-06 新增)
  execution:
    max_slippage_pct: 0.005                   # 市价单最大滑点控制 (0.5%)
    order_retry_base_offset: 0.002            # 订单重试基础偏移 (0.2%)
    execution_monitor_slippage_alert: 0.01    # 滑点>1% 告警
    execution_monitor_reject_rate_alert: 0.10 # 拒绝率>10% 告警

# ============================================================================
# 4. 风控配置 (五层风控体系)
# ============================================================================
risk_limits:
  # --- 信号级检查 ---
  min_confidence: 0.35              # 最小置信度阈值 (2026-04-22: 0.55→0.35, 实测均值0.36，原阈值过高导致0%执行率)
  
  # 2026-04-13 Phase 2: 分层风控配置 (Source-Aware Risk Check)
  # 根据信号来源 (SignalSource) 应用不同的置信度门槛和仓位限制
  source_aware_risk:
    technical:
      min_confidence: 0.35          # 纯技术信号 (2026-04-22: 0.50→0.35)
      max_position: 0.08            # 单笔最大仓位 (2026-04-18: 18%->8%)
    event:
      min_confidence: 0.40          # 事件驱动信号 (2026-04-22: 0.60→0.40)
      max_position: 0.05            # 限制仓位，控制事件反转风险 (2026-04-18: 10%->5%)
    hybrid:
      min_confidence: 0.35          # 共振信号 (2026-04-22: 0.50→0.35)
      max_position: 0.08            # 提高仓位上限 (2026-04-18: 25%->8%, 对齐安全底线)
    cross_market:
      min_confidence: 0.35          # 跨市场信号 (2026-04-22: 0.50→0.35)
      max_position: 0.08            # (2026-04-18: 15%->8%)

  # 2026-04-13 Phase 2: 分时段风控配置 (Time-Aware Risk Check)
  # 港股交易时段: 09:30-12:00, 13:00-16:00
  time_aware_risk:
    opening:
      start: "09:30"
      end: "10:00"
      min_confidence: 0.35          # P0 2026-04-19: 0.20→0.35 (配合代码 70% 下限保护)
      max_position: 0.05            # 限制仓位 (2026-04-18: 10%->5%)
      # 开盘波动大，降低门槛但保持基本质量 (0.35 ≥ source_aware 0.50 × 0.70 = 0.35)
    mid_day:
      start: "12:00"
      end: "13:00"
      min_confidence: 0.35          # P0 2026-04-19: 0.20→0.35
      max_position: 0.08
    afternoon:
      start: "10:00"
      end: "12:00"
      min_confidence: 0.35          # 2026-04-22: 0.40→0.35 (对齐实测均值)
      max_position: 0.10
    closing:
      start: "13:00"
      end: "16:00"
      min_confidence: 0.35          # P0 2026-04-19: 0.20→0.35
      max_position: 0.08

  # --- 订单级检查 ---
  max_single_position: 0.08         # 单笔最大仓位 8% (2026-04-18: 18%->8%, Phase A 安全底线优先)
  max_single_loss: 0.05             # 单笔最大亏损 5%

  # --- 仓位级检查 ---
  max_total_position: 0.75          # 总仓位限制 75%
  max_daily_trades: 5               # 日交易次数 5 次
  max_daily_loss: 0.03              # 日亏损 3%
  max_weekly_loss: 0.08             # 周亏损 8%

  # --- 账户级检查 ---
  max_drawdown: 0.12                # 最大回撤 12%
  max_monthly_loss: 0.15            # 月度最大亏损 15% (2026-04-18 Phase A 新增: 安全底线)
  consecutive_loss_limit: 3         # 连续亏损限制 3 次

  # --- 策略级检查 ---
  strategy_min_trades: 20           # 策略最小交易数
  strategy_min_winrate: 0.45        # 策略最小胜率 45%

# 止损止盈基础配置 (2026-04-05 更新 - 基于梯度测试推荐：Sharpe=1.31)
# 推荐参数：stop_loss=-3%, take_profit=10%
stop_loss:
  default_percent: 0.03             # 默认止损 3% (梯度测试推荐)
  trailing_percent: 0.02            # 移动止损 2%
  max_holding_hours: 48             # 最大持仓 48 小时
  atr_multiplier: 2.5               # ATR 乘数 2.5

# 止盈配置
take_profit:
  default_percent: 0.10             # 默认止盈 10% (梯度测试推荐)
  trailing_percent: 0.02            # 移动止盈 2%
  time_limit_hours: 48              # 时间止盈 48 小时
  rsi_overbought: 70                # RSI 超买阈值
  macd_dead_cross: true             # MACD 死叉止盈

  # 保本止损
  breakeven:
    enabled: true
    trigger_profit: 0.03            # 盈利 3% 后启用保本
    stop_level: 0.01                # 止损上移到成本价 +1%

# 信号冷却配置
signal_cooldown:
  default_seconds: 120              # Pipeline冷却期 120 秒 (CooldownCheck使用)
  high_confidence_seconds: 90       # 高置信度冷却 90 秒
  after_loss_seconds: 180           # 亏损后冷却 180 秒

# 亏损暂停配置
loss_pause:
  enabled: true
  consecutive_losses: 3             # 连续亏损 3 次
  pause_minutes: 60                 # 暂停 60 分钟

# 熔断器配置
circuit_breaker:
  daily_loss_limit: -3000           # 日亏损限额 -3000
  pause_on_triggered: true          # 触发后暂停交易

# ============================================================================
# 5. 策略配置
# ============================================================================
strategy:
  # 外部权重引擎脚本路径 (2026-04-26 P0-7 新增)
  # 优先级：env FTSEEK_WEIGHT_ENGINE_PATH > 本字段 > 相对路径 fallback
  weight_engine_path: "/opt/ftseek/FTSeek/strategies/weight_engine.py"

  # 启用的策略 (2026-04-05 更新)
  enabled:
    primary: "confluence_v2"        # 主力融合策略
    trend: "none"                 # supertrend 已内嵌到 confluence_v2 中，此处禁用避免重复
    sentiment: "sentiment_ai"       # AI 情绪策略
    open_close: "open_close_effect" # 开盘/收盘效应策略

  # 禁用的策略
  disabled:
    - "rsi"
    - "macd"
    - "bollinger"
    - "confluence"
    - "price_break"

  # 策略权重
  weights:
    confluence_v2: 1.5
    supertrend: 0.0                # 禁用：已包含在 confluence_v2 因子中，权重归零
    sentiment_ai: 0.5               # 2026-04-06: 从 0.8 降至 0.5，与代码基准一致
    # 新增策略 (2026-04-09)
    event_driven: 1.2               # 事件驱动：高优先级突发信号
    cross_market_arbitrage: 1.0      # 跨市场套利：中优先级
    enhanced_confluence: 1.3         # 增强融合：多因子 + 多周期
    open_close_effect: 0.8           # 开盘/收盘效应：辅助信号

  # 共识引擎配置
  consensus:
    threshold: 1.5                  # 触发阈值 (2026-04-06: 从 1.1 提高，减少误判)
    min_strategies: 2               # 最少策略数
    window_seconds: 90              # 共识窗口 (秒)
    adx_trend: 25                   # ADX 趋势判定
    adx_range: 20                   # ADX 震荡判定
    short_bias_factor: 1.0          # 做空偏置因子

    # 策略分歧度控制 (2026-04-13 新增)
    # 当 BUY 和 SELL 策略严重分歧时，降级信号质量
    divergence_threshold: 0.5       # 分歧度阈值: min(bull,bear)/max(bull,bear) >= 此值时触发衰减
    divergence_score_decay: 0.5     # 分歧时分数衰减系数: score *= (1 - divergence * decay)
    divergence_trigger_gray: true   # 高分歧时自动标记灰区场景

    # 自适应权重时间窗 (2026-04-13 新增)
    # 分层胜率计算: 短窗(近期) + 中窗 + 长窗 加权
    adaptive_short_window: 20       # 短期回看窗口 (最近 N 笔交易)
    adaptive_medium_window: 60      # 中期回看窗口
    adaptive_long_window: 200       # 长期回看窗口
    adaptive_short_weight: 0.3      # 短期胜率权重
    adaptive_medium_weight: 0.5     # 中期胜率权重 (最高权重)
    adaptive_long_weight: 0.2       # 长期胜率权重
    adaptive_long_term_disable_threshold: 0.30  # 长期胜率低于此值时触发降权警告

    # 策略场景失效检测 (2026-04-13 新增)
    scenario_consecutive_fail_limit: 3   # 连续失败次数触发降权
    scenario_fail_penalty: -0.10         # 失效惩罚 delta

  # 信号融合权重 (2026-04-21 新增: 港股政策敏感型配置)
  signal_fusion:
    technical_weight: 0.3     # 技术面权重 (低于美股)
    sentiment_weight: 0.2     # 情绪面权重
    macro_weight: 0.1         # 宏观面权重
    policy_weight: 0.4        # 政策面权重 (港股核心因子)
    veto_policy_negative: true  # 政策负面一票否决

  # 信号冷却配置 (2026-04-06 从 app/config.py 迁移)
  cooldown:
    signal_cooldown: 120            # 信号冷却时间 (秒)

  # 决策缓冲层配置 (2026-04-09 新增)
  decision_buffer:
    signal_cooldown: 120            # 信号去重冷却 (秒)，与 Pipeline CooldownCheck 一致
    max_pending: 500                # 最大待处理队列长度 (2026-04-22: 200→500)
    min_confidence: 0.35            # 2026-04-24 统一: 0.55→0.35 对齐 risk_limits.min_confidence
    max_positions: null             # 最大持仓数量 (null=动态计算)

  # 置信度调整器配置 (2026-04-09 新增)
  confidence_adjuster:
    min_confidence: 0.35            # 2026-04-24 统一: 0.55→0.35 对齐 risk_limits.min_confidence
    max_single_penalty: 0.15        # 单次最大惩罚
    max_total_penalty: 0.40         # 累计最大惩罚
    max_single_boost: 0.10          # 单次最大增强
    max_total_boost: 0.20           # 累计最大增强

  # 订阅类型配置 (2026-04-06 从 app/config.py 迁移)
  subscribe_types: ["QUOTE", "K_1M", "K_3M", "K_5M", "K_15M", "K_30M", "K_60M", "K_DAY"]

  # AI 配置
  ai:
    weight: 0.15                    # AI 权重 15%
    min_accuracy: 0.50              # 最低准确率 50%
    disable_threshold: 0.45         # 禁用阈值 45%
    signal_boost: 1.1               # 信号增强系数

  # 融合权重
  fusion:
    technical_weight: 0.60          # 技术指标权重 60%
    sentiment_weight: 0.25          # 情绪权重 25%
    ai_weight: 0.15                 # AI 权重 15%

  # 趋势过滤
  trend_filter:
    enabled: true
    use_multi_timeframe: true
    ma_period_short: 5
    ma_period_long: 20
    prevent_buy_in_downtrend: true
    prevent_short_in_uptrend: true
    # P0 (2026-05-16): ADX 范围市场门禁
    # ADX < 此值时判定为震荡市，禁止买入（BB/RSI 假信号风险高）
    adx_range_gate: 18

  # P0 (2026-05-16): 时段门禁
  # 港股 14:30 后禁止开新仓，防止盘末退出 (15:45) 强平刚开的仓位
  time_gate:
    enabled: true
    hk_latest_open: "14:30"    # 最晚开仓时间 (HK 时间)

  # P2 (2026-05-16): 市场趋势门禁
  # 恒指 MA5 < MA20 (下跌趋势) 时禁止开新仓，避免逆市做多
  market_regime_gate:
    enabled: true

  # 做多信号参数
  long_signals:
    rsi_oversold: 35
    macd_histogram_threshold: 0.001
    supertrend_multiplier: 2.5
    min_confidence: 0.35              # 2026-04-24 统一: 0.55→0.35 对齐 risk_limits

  # 做空信号参数
  short_signals:
    rsi_overbought: 60
    macd_histogram_threshold: 0.0005
    supertrend_multiplier: 2.0
    min_confidence: 1.0
    volume_confirm: 1.5
    trend_confirm: true

  # ============================================================
  # 策略详细参数配置 (从 app/config.py 迁移，2026-04-06)
  # ============================================================
  # 说明：每个策略的完整参数配置，支持运行时动态加载
  # 格式：strategy.<strategy_name>.<param>
  # ============================================================

  # --- 价格阈值突破策略 ---
  price_break:
    enabled: false
    thresholds:
      # 港股标的阈值 (港币)
      "HK.09992": { "upper": 219.0, "lower": 217.0 }   # 泡泡玛特
      "HK.00981": { "upper": 60.5, "lower": 59.5 }     # 中芯国际
      "HK.03690": { "upper": 82.0, "lower": 80.0 }     # 美团
      "HK.00700": { "upper": 540.0, "lower": 500.0 }   # 腾讯
      "HK.09988": { "upper": 155.0, "lower": 140.0 }   # 阿里
      # 美股标的阈值 (美元)
      "US.AAPL": { "upper": 260.0, "lower": 230.0 }    # 苹果
      "US.TSLA": { "upper": 380.0, "lower": 320.0 }    # 特斯拉
      "US.NVDA": { "upper": 145.0, "lower": 120.0 }    # 英伟达
      "US.MSFT": { "upper": 430.0, "lower": 390.0 }    # 微软
      "US.AMZN": { "upper": 235.0, "lower": 210.0 }    # 亚马逊

  # --- 成交量异动策略 ---
  volume_alert:
    enabled: false
    volume_ratio_threshold: 2.0       # 成交量是近期均值的 N 倍时触发
    lookback_periods: 20

  # --- RSI 超买超卖策略 ---
  rsi:
    enabled: false
    period: 14
    overbought: 70
    oversold: 30

  # --- MACD 趋势跟踪策略 ---
  macd:
    enabled: false
    fast_period: 12
    slow_period: 26
    signal_period: 9
    signal_mode: "histogram"          # histogram | zero_cross | both

  # --- 布林带策略 ---
  bollinger:
    enabled: false
    period: 20
    std_dev: 2.0
    mode: "reversion"                 # reversion | breakout

  # --- SuperTrend 自适应趋势策略 ---
  supertrend:
    enabled: true
    atr_period: 10
    multiplier: 2.0                   # 2026-03-19: 从 3.0 降至 2.0，更敏感

  # --- 多因子融合策略 (核心策略) ---
  confluence:
    enabled: false
    min_factors: 3                    # 至少 N 个因子同向确认
    enabled_factors: ["rsi", "macd", "bollinger", "supertrend", "ma_cross", "volume"]
    rsi_period: 14
    rsi_overbought: 70
    rsi_oversold: 30
    macd_fast: 12
    macd_slow: 26
    macd_signal: 9
    bb_period: 20
    bb_std: 2.0
    st_period: 10
    st_multiplier: 3.0
    ma_fast: 10
    ma_slow: 30
    vol_ratio: 1.5
    adx_threshold: 25

  # --- 多因子融合 V2 (市场状态增强版) ---
  confluence_v2:
    enabled: true
    min_factors: 3
    enabled_factors: ["rsi", "macd", "bollinger", "supertrend", "ma_cross", "volume"]
    use_market_regime: true           # 市场状态感知
    use_dynamic_weights: true         # 动态因子权重

    # 技术指标参数
    rsi_period: 14
    rsi_overbought: 70
    rsi_oversold: 30
    macd_fast: 12
    macd_slow: 26
    macd_signal: 9
    bb_period: 20
    bb_std: 2.0
    st_period: 10
    st_multiplier: 2.5
    ma_fast: 10
    ma_slow: 30
    vol_ratio: 1.5
    adx_threshold: 25

    # 出场控制参数
    stop_loss_pct: 0.05               # 5% 止损
    take_profit_pct: 0.10             # 10% 止盈
    use_atr_stop: true                # 使用 ATR 动态止损
    atr_multiplier: 2.0               # ATR 乘数
    max_holding_periods: 15           # 港股最大持仓周期 (15 日)
    order_type: "market"              # 市价单
    retry_count: 3                    # 订单重试次数

# ============================================================================
# 4.1 信号融合差异化配置 (Phase 2: HK vs US)
# ============================================================================
signal_fusion:
  # 港股 (HK) 特性: 政策敏感 + 资金驱动 + "政策一票否决"
  hk:
    policy_weight: 0.40           # 政策/消息面权重 (极高)
    technical_weight: 0.30        # 技术面权重
    flow_weight: 0.30             # 南向资金/流动性权重
    
    # 政策一票否决: 若 LLM 识别到强负面政策 (如反垄断/制裁)，直接切断做多信号
    policy_veto:
      enabled: true
      threshold: 0.80             # Policy Risk Score > 0.80 触发否决
      veto_actions: ["BUY"]       # 仅否决买入信号

  # 美股 (US) 特性: 机构主导 + 技术有效 + "宏观共振"
  us:
    technical_weight: 0.50        # 技术面权重 (极高)
    news_weight: 0.20             # 新闻/情绪权重
    macro_weight: 0.30            # 宏观/大盘联动权重
    
    # 宏观共振: 若 SPY 趋势与个股信号一致，提升置信度；背离则降低
    macro_resonance:
      enabled: true
      alignment_bonus: 1.20       # SPY 同向时 Score * 1.2
      divergence_penalty: 0.80    # SPY 背离时 Score * 0.8
      trend_proxy: "SPY"          # 大盘趋势代理指标

# ============================================================================
# 5. 风险管理配置 (Risk Management)
# ============================================================================
risk:
  # 基础风控
  max_position_size: 0.20           # 单只股票最大仓位占比 20%

  # --- 融合策略 v2.0 (技术 + 情绪) ---
  # 2026-04-06 禁用：与 confluence_v2 功能重叠，避免信号冲突
  fusion_v2:
    enabled: false
    # 投票权重
    technical_weight: 0.5             # 技术指标权重
    sentiment_weight: 0.5             # 情绪权重

    # 置信度阈值
    min_confidence: 0.35            # 2026-04-24 统一: 0.50→0.35 对齐 risk_limits.min_confidence
    signal_level_threshold: "recommended"
    per_stock_daily_limit: 2          # 每股票每日限制 2 次
    global_daily_limit: 20

    # 情绪参数
    sentiment_threshold: 0.31
    sentiment_lookback_hours: 12
    sentiment_max_news: 5

    # 技术指标参数
    rsi_period: 14
    rsi_overbought: 70
    rsi_oversold: 30
    macd_fast: 12
    macd_slow: 26
    macd_signal: 9
    ma_fast_period: 10
    ma_slow_period: 30
    bb_period: 20
    bb_std: 2.0

    # 出场控制参数 (ATR 止损 2.5x)
    stop_loss_atr_multiplier: 2.5
    take_profit_rr_ratio: 2.0

  # --- AI 情绪策略 ---
  sentiment_ai:
    enabled: true
    positive_threshold: 0.4           # 情绪得分 > 0.4 触发买入
    negative_threshold: -0.4          # 情绪得分 < -0.4 触发卖出
    cooldown_seconds: 7200            # 信号冷却时间 2 小时
    lookback_hours: 24                # 分析最近 24 小时新闻
    max_news: 20                      # 最多分析 20 条新闻

  # --- 开盘/收盘效应策略 ---
  open_close_effect:
    enabled: true
    open_breakout_threshold: 0.02     # 开盘 2% 突破
    open_volume_ratio: 1.5            # 成交量 1.5 倍
    open_window_minutes: 30           # 开盘 30 分钟内
    close_trend_threshold: 0.015      # 收盘 1.5% 趋势
    close_window_minutes: 30          # 收盘前 30 分钟

# ============================================================================
# 6. 动态止盈止损 (按市场状态)
# ============================================================================
dynamic_exit:
  # 强上涨趋势
  strong_trend_up:
    stop_loss: -0.06
    take_profit: 0.08
    trailing_stop:
      enabled: true
      trigger_profit: 0.06
      trail_percent: 0.04
    atr_stop:
      multiplier: 2.8
      preferred_kline: "K_60M"
    time_stop:
      max_holding_hours: 120

  # 震荡市
  range_bound:
    stop_loss: -0.035
    take_profit: 0.05
    trailing_stop:
      enabled: true
      trigger_profit: 0.025
      trail_percent: 0.018
    atr_stop:
      multiplier: 1.6
      preferred_kline: "K_30M"
    time_stop:
      max_holding_hours: 36

  # 强下跌趋势
  strong_trend_down:
    stop_loss: -0.03
    take_profit: 0.045
    trailing_stop:
      enabled: true
      trigger_profit: 0.02
      trail_percent: 0.015
    atr_stop:
      multiplier: 1.4
      preferred_kline: "K_15M"
    time_stop:
      max_holding_hours: 24

  # 高波动市场
  high_volatility:
    stop_loss: -0.07
    take_profit: 0.09
    trailing_stop:
      enabled: true
      trigger_profit: 0.05
      trail_percent: 0.045
    atr_stop:
      multiplier: 3.2
      preferred_kline: "K_60M"
    time_stop:
      max_holding_hours: 96

  # 默认配置
  default:
    stop_loss: -0.035
    take_profit: 0.05
    trailing_stop:
      enabled: true
      trigger_profit: 0.025
      trail_percent: 0.015
    atr_stop:
      multiplier: 2.0
      preferred_kline: "K_30M"
    time_stop:
      max_holding_hours: 48

# ============================================================================
# 7. 通知配置
# ============================================================================
notification:
  dingtalk:
    enabled: true
    mode: enterprise                # enterprise | webhook

    # Webhook 模式配置
    webhook_url: "${DINGTALK_WEBHOOK_URL}"
    secret: "${DINGTALK_SECRET}"

    # 企业应用模式配置
    app_key: "${DINGTALK_APP_KEY}"
    app_secret: "${DINGTALK_APP_SECRET}"
    agent_id: "${DINGTALK_AGENT_ID}"

    # 推送配置
    timeout: 600                    # 确认超时 10 分钟
    push_on_signal: true
    push_on_execution: true
    push_on_error: true

  # 告警联系人
  alerts:
    contacts:
      - name: "管理员"
        phone: "${ADMIN_PHONE}"
        email: "${ADMIN_EMAIL}"

# 定时推送配置
schedule:
  daily_stats_time: "16:30"
  weekly_report_time: "09:00"
  monthly_report_time: "09:00"
  risk_monitor_interval: 120        # 风控监控间隔 (秒)

# ============================================================================
# 8. 市场配置
# ============================================================================
markets:
  hk:
    market_type: hk
    currency: HKD
    trading_hours:
      open: "09:30"
      close: "16:00"
      lunch_break_start: "12:00"
      lunch_break_end: "13:00"
    check_interval: 300
    night_interval: 900

  us:
    market_type: us
    currency: USD
    trading_hours:
      open: "21:30"
      close: "04:00"
    check_interval: 300
    night_interval: 900

# 监控股票列表
# --- 已迁移至 trading.watch_list_hk (30 只)，此节点已废弃 ---
# watchlist.hk_stocks: 保留空节点用于向后兼容
watchlist:
  hk_stocks: []
  us_stocks: []
  options: []

# ============================================================================
# 9. 日志配置
# ============================================================================
logging:
  level: INFO
  format: "%(asctime)s [%(name)s] [%(trace_id)s] %(levelname)s: %(message)s"
  dir: logs

  # 日志文件
  files:
    main: ftseek.log
    error: ftseek_error.log
    warning: ftseek_warning.log
    trade: trades.log
    risk: risk.log

  # 轮转配置
  max_size_mb: 50
  backup_count_size: 5
  backup_count_daily: 30

  # 功能开关
  enable_json_format: false
  enable_trace_id: true
  console_output: true

# ============================================================================
# 10. 功能开关
# ============================================================================
features:
  four_step_confirmation: true      # 四步确认流程
  auto_confirm: true                # 超时自动确认
  smart_push: true                  # 智能推送决策
  state_persistence: true           # 状态持久化
  decision_logging: true            # 决策日志
  session_management: true          # 会话管理
  config_hot_reload: true           # 配置热重载

# 四步确认配置
four_step:
  min_signal_score: 0.50
  min_confidence: 0.60
  manual_confirm_min_confidence: 0.75
  auto_confirm_timeout: 600

# 智能推送配置
smart_push:
  manual_confirm_min_confidence: 0.75
  manual_confirm_min_score: 0.70
  momentum_threshold: 0.70
  pattern_threshold: 0.65
  auto_execute_min_confidence: 0.60

# ============================================================================
# 11. 状态持久化配置
# ============================================================================
persistence:
  state_file: data/state_snapshot.json
  decision_log_file: data/decision_log.json
  sessions_dir: data/sessions
  auto_snapshot_interval: 300       # 自动快照间隔 (秒)
  max_decision_log_entries: 10000
  session_expiry_hours: 24

# ============================================================================
# 12. 监控配置
# ============================================================================
monitoring:
  metrics:
    enabled: true
    collect_interval: 10
    storage_dir: data/metrics
    retention_hours: 24
    core_metrics:
      - system_cpu_percent
      - system_memory_percent
      - system_disk_percent
      - opend_connection_status
      - trade_success_rate
      - signal_count

  alerts:
    enabled: true
    rules_config: config/alert_rules.yaml
    storage_dir: data/alerts
    default_cooldown: 3600

  health_check:
    enabled: true
    port: 8899
    endpoints:
      - /health
      - /health/live
      - /health/ready
      - /health/status
      - /health/metrics

# ============================================================================
# 13. AI 服务配置
# ============================================================================
ai:
  provider: bailian                 # bailian | openai | custom
  api_key: "${BAILIAN_API_KEY}"
  endpoint: "${BAILIAN_ENDPOINT}"
  model: "${BAILIAN_MODEL}"
  timeout: 30

  # 预算控制
  daily_budget: 50
  monthly_budget: 1500

  # 缓存配置
  cache:
    enabled: true
    ttl: 3600                       # 缓存有效期 (秒)
    max_size: 1000

  # 限流配置
  rate_limit:
    requests_per_minute: 10

# ============================================================================
# 14. 服务器配置
# ============================================================================
server:
  callback_host: "0.0.0.0"
  callback_port: 8899
  callback_external_url: "http://39.97.58.4:8899"

  # API 鉴权
  api_token: "${API_TOKEN}"
  tradingview_webhook_token: "${TRADINGVIEW_WEBHOOK_TOKEN}"

  # 安全配置
  rate_limit:
    max_requests: 30                # 每分钟最大请求数
    window_seconds: 60

  # 信号配置
  signal_expire_seconds: 300        # 信号有效期 5 分钟

# ============================================================================
# 15. 数据库配置
# ============================================================================
database:
  type: sqlite
  path: data/ftseek.db

  # 连接池配置
  pool:
    enabled: false
    max_connections: 10
    timeout: 30

  # 备份配置
  backup:
    enabled: true
    interval_hours: 24
    retention_days: 30
    backup_dir: data/backups

# ============================================================================
# 16. 回测配置
# ============================================================================
backtest:
  presets_file: config/backtest_presets.json

  # 默认回测参数
  default:
    initial_capital: 1000000
    commission_rate: 0.0003
    slippage: 0.001
    start_date: "2025-01-01"
    end_date: "2025-12-31"

# ============================================================================
# 17. 配置迁移说明
# ============================================================================
migration:
  note: "本配置文件已整合所有分散配置"
  merged_files:
    - risk_config.yaml
    - strategy_params.json
    - dynamic_exit_params.yaml
    - position_strategy.yaml
    - app_config.yaml
    - system_config.yaml

  deprecated_after: "2026-04-30"
  action: "移至 config/deprecated/ 目录"

# ============================================================================
# 18. 质量管理器配置 (巴菲特理念实现，2026-04-06 新增)
# ============================================================================

# --- 质量评分器配置 ---
quality_scorer:
  enabled: true

  # 权重配置 (总和=1.0)
  weights:
    roe: 0.30           # ROE 最重要 (巴菲特核心指标)
    debt: 0.20          # 负债率
    cashflow: 0.20      # 现金流
    margin: 0.15        # 毛利率
    growth: 0.15        # 增长

  # 等级阈值
  class_thresholds:
    class_a: 80         # >=80 为优质企业
    class_b: 60         # >=60 为良好企业
    class_c: 40         # >=40 为一般企业
    # <40 为垃圾企业 (过滤)

  # 仓位上限 (按质量等级)
  position_limits:
    class_a: 0.30       # 优质股最大 30% 仓位
    class_b: 0.20       # 良好股最大 20% 仓位
    class_c: 0.10       # 一般股最大 10% 仓位
    junk: 0.00          # 垃圾股不买入

# --- 持仓周期管理器配置 ---
holding_period:
  enabled: true

  # 各等级持仓期限 (小时)
  max_holding_hours:
    class_a: null       # 优质股无时间限制 (仅估值止盈)
    class_b: 168        # 良好股 7 天
    class_c: 48         # 一般股 48 小时
    junk: 24            # 垃圾股尽快离场

  # 复查间隔 (小时)
  review_intervals:
    class_a: 24         # 每日复查
    class_b: 12         # 每 12 小时复查
    class_c: 6          # 每 6 小时复查
    junk: 4             # 每 4 小时复查

# --- 资金水位管理器配置 ---
water_level:
  enabled: true

  # 初始资金 (用于计算水位)
  initial_capital: 1000000  # 100 万港币

  # 水位等级配置
  levels:
    green:
      min_ratio: 0.95
      max_single_position: 0.08         # 单笔最大仓位 8% (2026-04-18: 20%->8%)
      # max_total_position → 已移至 risk_limits 部分，避免重复
      max_daily_trades: 5
      risk_per_trade: 0.02
      # max_daily_loss → 已移至 risk_limits 部分，避免重复
      quality_min_class: "C"
      leverage_factor: 1.0

    yellow:
      min_ratio: 0.85
      # max_single_position → 已移至 risk_limits 部分，避免重复
      max_total_position: 0.60
      max_daily_trades: 3
      risk_per_trade: 0.015
      max_daily_loss: 0.02
      quality_min_class: "B"
      leverage_factor: 0.75

    orange:
      min_ratio: 0.75
      max_single_position: 0.08         # (2026-04-18: 10%->8%)
      max_total_position: 0.40
      max_daily_trades: 1
      risk_per_trade: 0.01
      max_daily_loss: 0.01
      quality_min_class: "A"
      leverage_factor: 0.50

    red:
      min_ratio: 0.0
      max_single_position: 0.00
      max_total_position: 0.00
      max_daily_trades: 0
      risk_per_trade: 0.00
      max_daily_loss: 0.00
      quality_min_class: "JUNK"
      leverage_factor: 0.0
      action: "LIQUIDATE"

# --- 止盈止损管理器配置 (落袋为安理念) ---
profit_loss:
  enabled: true

  # 分批止盈配置
  partial_take_profit:
    enabled: true

    # 第一层：落袋为安 (5%/10% 各止盈 25%)
    level_1:
      trigger: 0.05       # 盈利 5% 触发
      ratio: 0.25         # 止盈 25% 仓位

    level_2:
      trigger: 0.10       # 盈利 10% 触发
      ratio: 0.25         # 止盈 25% 仓位

    # 第二层：趋势止盈 (SuperTrend/MACD 转向)
    trend_exit:
      enabled: true
      signals:
        - supertrend_turn
        - macd_dead_cross
      ratio: 0.50         # 止盈 50% 仓位

    # 第三层：估值止盈 (仅优质股)
    valuation_exit:
      enabled: true
      pe_percentile: 0.80   # PE 分位点>80% 清仓

  # 动态止损配置
  dynamic_stop_loss:
    # 初始止损
    initial_stop:
      percent: 0.03       # 3% 初始止损

    # 保本止损
    breakeven:
      trigger_profit: 0.03  # 盈利 3% 后触发
      stop_level: 0.01      # 止损上移至成本价 +1%

    # 追踪止盈
    trailing:
      trigger_profit: 0.05  # 盈利 5% 后启动
      trail_percent: 0.03   # 从最高点回撤 3% 止盈

    # 分级止损 (盈利越高，止损越宽松)
    tiered_stops:
      - profit_level: 0.10
        stop_level: 0.05    # 盈利 10% 后，止损锁定在 5%
      - profit_level: 0.20
        stop_level: 0.12    # 盈利 20% 后，止损锁定在 12%
      - profit_level: 0.30
        stop_level: 0.20    # 盈利 30% 后，止损锁定在 20%

  # 按质量等级差异化止盈
  exit_by_quality:
    class_a:
      # 优质股：估值止盈 + 趋势止盈，无固定止盈
      valuation_exit: true
      trend_exit: true
      fixed_exit: false
      trailing_type: "supertrend"
      initial_stop: 0.05      # 给更多波动空间

    class_b:
      # 良好股：分批止盈 + 趋势止盈
      partial_exit: true
      trend_exit: true
      fixed_target: 0.15
      trailing_type: "percentage"
      trail_percent: 0.05

    class_c:
      # 一般股：固定止盈，快进快出
      fixed_exit: true
      fixed_target: 0.10
      trailing_type: "breakeven"

    junk:
      # 垃圾股：快速止盈，tight 止损
      fixed_exit: true
      fixed_target: 0.05
      initial_stop: 0.02

# ============================================================================
# 19. 盘前 Pipeline 配置 (新闻→事件包→LLM分析→交易路由，2026-04-12 新增)
# ============================================================================
premarket_pipeline:
  enabled: true

  # 调度时间 (HKT)
  schedule:
    times: ["08:30", "09:00"]     # 开盘前两次运行
    timezone: "Asia/Hong_Kong"

  # 新闻清洗
  cleaner:
    dedup_threshold: 0.85
    min_content_length: 8
    max_content_length: 2000
    filter_clickbait: true

  # 事件聚类
  clusterer:
    time_window_minutes: 120
    max_clusters: 10
    theme_generation: "rule"

  # 相关性评分
  relevance:
    weights:
      stock: 0.4
      policy: 0.2
      earnings: 0.2
      urgency: 0.2
    min_overall_score: 0.2

  # 事件包构造
  pack_builder:
    max_articles_per_pack: 5
    include_market_context: true

  # LLM 分析 (混合模型)
  analyst:
    fast_model: "qwen3.6-flash"    # 批量初筛 (极速)
    deep_model: "qwen3.6-plus"     # 深度分析/宏观策略 (高精度，稳定)
    deep_threshold: 0.5            # relevance >= 0.5 使用 deep_model
    timeout: 60                    # 初筛超时
    deep_timeout: 120              # 深度分析超时
    max_retries: 2
    enable_thinking: true
    batch_size: 3

  # 策略路由
  router:
    auto_execute_threshold: 0.75
    review_threshold: 0.55

  # DingTalk 通知
  dingtalk:
    send_summary: true
    send_review_cards: true
    max_cards_per_run: 5


# ====================================================================
#  退出策略配置 (Trade Exit Strategy)
# ====================================================================
exit:
    hk:
        atr_multiplier: 3.0   # 止损宽度 (3.0 ATR)
        stop_pct: 0.03        # 固定止损兜底 (3%)
        crash_guard_pct: 0.08 # 1 分钟闪崩阈值 (8%)
    us:
        atr_multiplier: 1.5   # 止损宽度 (1.5 ATR)
        stop_pct: 0.015       # 固定止损兜底 (1.5%)
        time_stop_minutes: 30 # 时间止损 (30 分钟)
