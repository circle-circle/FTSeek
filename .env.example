# FTSeek-US 环境变量配置
# 复制此文件为 .env 并填入真实值

# ==================== 富途交易密码 ====================
# 用于实盘交易 (模拟模式不需要)
FUTU_TRADE_PASSWORD=

# ==================== 钉钉推送配置 ====================
# 从钉钉机器人获取
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=YOUR_TOKEN
DINGTALK_SECRET=

# ==================== 富途用户 ID ====================
# 用于查询账户信息 (可选)
FUTU_USER_ID=
