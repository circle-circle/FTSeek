# ============================================================
#  FTSeek 环境变量配置模板
#  用法：复制此文件为 .env 或 systemd 服务文件中的 Environment
#  命令：cp .env.example .env  然后编辑 .env 文件
# ============================================================

# ============================================================
#  🔐 安全相关 (必须修改)
# ============================================================

# API 鉴权 Token - 用于保护管理 API 和确认回调
# 生成方法：python3 -c "import secrets; print(secrets.token_hex(32))"
API_TOKEN=

# TradingView Webhook Token (可选，默认与 API_TOKEN 相同)
TRADINGVIEW_WEBHOOK_TOKEN=

# ============================================================
#  钉钉推送配置 (必须修改)
# ============================================================

# 钉钉机器人 Webhook URL (从钉钉群机器人设置获取)
DINGTALK_WEBHOOK_URL=

# 钉钉机器人加签 Secret (从钉钉群机器人设置获取)
DINGTALK_SECRET=

# ============================================================
#  富途 OpenD 配置 (可选，默认值通常可用)
# ============================================================

# OpenD 服务地址
OPEND_HOST=127.0.0.1
OPEND_PORT=11111

# OpenD 安装目录
OPEND_DIR=/opt/ftseek/Futu_OpenD_9.6.5618_Centos7/Futu_OpenD_9.6.5618_Centos7

# 富途账号 (建议优先在 FutuOpenD.xml 中配置)
FUTU_LOGIN_ACCOUNT=
FUTU_LOGIN_PWD=

# 交易环境：0=真实，1=模拟 (默认模拟)
TRADE_ENV=1

# ============================================================
#  FastAPI 回调服务配置 (可选)
# ============================================================

# 监听地址
CALLBACK_HOST=0.0.0.0
CALLBACK_PORT=8899

# 外部访问地址 (用于生成确认链接，需填写公网 IP)
CALLBACK_EXTERNAL_URL=http://39.97.58.4:8899

# 信号有效期 (秒)
SIGNAL_EXPIRE_SECONDS=300

# ============================================================
#  监控标的配置 (按需修改)
# ============================================================

# 港股监控列表
WATCH_LIST_HK=["HK.00700","HK.09988","HK.09992"]

# 美股监控列表
WATCH_LIST_US=["US.AAPL","US.TSLA","US.NVDA","US.MSFT","US.AMZN"]

# 订阅类型：QUOTE, K_1M, K_5M, K_15M, K_DAY
SUBSCRIBE_TYPES=["QUOTE","K_1M"]

# ============================================================
#  交易配置 (按需修改)
# ============================================================

# 默认下单数量
DEFAULT_ORDER_QTY_HK=100
DEFAULT_ORDER_QTY_US=1

# 订单类型：MARKET 或 LIMIT
DEFAULT_ORDER_TYPE=MARKET

# 最大单笔金额限制 (防止误操作)
MAX_ORDER_AMOUNT=50000.0

# ============================================================
#  共识引擎配置 (高级选项)
# ============================================================

# 共识窗口 (秒) - 多长时间内收集策略信号
CONSENSUS_WINDOW=60

# 触发阈值 - 加权分数超过此值才推送
CONSENSUS_THRESHOLD=1.5

# ADX 趋势判定线
CONSENSUS_ADX_TREND=25
CONSENSUS_ADX_RANGE=20

# 信号冷却时间 (秒) - 同标的同方向推送间隔
SIGNAL_COOLDOWN=300

# ============================================================
#  日志配置
# ============================================================

LOG_LEVEL=INFO

# 开发模式 (启用后 API_TOKEN 未设置会生成临时 token)
FTSEEK_DEV_MODE=false
